{
  "name": "@cracklincrotch/homebridge-tuya-platform",
  "displayName": "Tuya",
  "version": "1.7.0-beta.54",
  "description": "Fork version of official Tuya Homebridge plugin. Brings a bunch of bug fix and new device support.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cracklincrotch/homebridge-tuya-platform"
  },
  "homepage": "https://github.com/cracklincrotch/homebridge-tuya-platform#readme",
  "bugs": {
    "url": "https://github.com/0x5e/homebridge-tuya-platform/issues"
  },
  "funding": [
    {
      "type": "paypal",
      "url": "https://paypal.me/0x5e"
    }
  ],
  "engines": {
    "node": ">=14.18.1",
    "homebridge": ">=1.3.5"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**/*.ts --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "npm run build && npm link && nodemon",
    "launch": "tsc && homebridge -I -D",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "homekit",
    "tuya"
  ],
  "dependencies": {
    "@homebridge/camera-utils": "^3.0.0",
    "async-await-retry": "^2.1.0",
    "color-convert": "^3.1.3",
    "crypto-js": "^4.2.0",
    "debounce": "^3.0.0",
    "jsonschema": "^1.5.0",
    "kelvin-to-rgb": "^1.0.2",
    "lodash.isequal": "^4.5.0",
    "mqtt": "^5.14.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/color-convert": "^2.0.4",
    "@types/crypto-js": "^4.2.2",
    "@types/debounce": "^1.2.4",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^25.0.9",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "homebridge": "^1.11.1",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
